{
  "name": "devmate",
  "displayName": "DevMate - AI Error Explainer",
  "description": "Select an error or stack trace and get a plain-English explanation and fix suggestion.",
  "version": "0.2.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devmateContainer",
          "title": "DevMate",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "devmateContainer": [
        {
          "type": "webview",
          "id": "devmateChatView",
          "name": "DevMate Chat",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "devmate.explainError",
        "title": "DevMate: Explain Selected Error"
      },
      {
        "command": "devmate.explainClipboard",
        "title": "DevMate: Explain Error from Clipboard"
      },
      {
        "command": "devmate.openChat",
        "title": "DevMate: Open Chat",
        "icon": "media/icon.svg"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "devmate.explainError",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "devmate.openChat",
          "group": "navigation",
          "when": "editorIsOpen"
        }
      ]
    },
    "keybindings": [
      {
        "command": "devmate.explainClipboard",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e"
      }
    ],
    "configuration": {
      "title": "DevMate",
      "properties": {
        "devmate.groqApiKey": {
          "type": "string",
          "default": "",
          "description": "Your free Groq API key (get one at console.groq.com/keys)"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0"
  }
}
